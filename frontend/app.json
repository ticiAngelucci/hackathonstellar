{
  "expo": {
    "name": "Pato Pay",
    "slug": "patopay-mobile",
    "scheme": "patopay",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permití que Pato Pay use Face ID para desbloquear la aplicación."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
