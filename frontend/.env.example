# Frontend integration values. The publishable key is safe for client use.
EXPO_PUBLIC_SUPABASE_URL=https://ekgfskibieqljhazchno.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-project-publishable-key
EXPO_PUBLIC_PATOPAY_USER_ID=11111111-1111-4111-8111-111111111111
EXPO_PUBLIC_PATOPAY_DISPLAY_NAME=Negro

# Wallet mode. Stellar is the default when this variable is omitted.
EXPO_PUBLIC_WALLET_MODE=stellar

# Stellar Testnet. Blank URLs use the official Testnet endpoints.
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
EXPO_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
EXPO_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Public smart-wallet contract metadata. The default hash follows passkey-kit 0.19.1.
EXPO_PUBLIC_STELLAR_WALLET_WASM_HASH=97ce047884106b1c6c3bb40b8973cc48db1c4dad95c9e20462bf2c701daa764e

# Public URL of the Pato Pay relayer proxy. Never expose the relayer API key here.
EXPO_PUBLIC_STELLAR_RELAYER_URL=https://ekgfskibieqljhazchno.supabase.co/functions/v1/stellar-relayer

# Native WebAuthn configuration. Host the Apple/Android association files here.
EXPO_PUBLIC_PASSKEY_RP_ID=wallet.example.com
# Comma-separated. Android uses android:apk-key-hash:<base64url-sha256-cert>.
EXPO_PUBLIC_PASSKEY_ALLOWED_ORIGINS=https://wallet.example.com,android:apk-key-hash:REPLACE_ME

# Asset shown and transferred by the wallet. Defaults to native Testnet XLM.
EXPO_PUBLIC_STELLAR_ASSET_CODE=XLM
EXPO_PUBLIC_STELLAR_ASSET_CONTRACT_ID=
EXPO_PUBLIC_STELLAR_ASSET_DECIMALS=7
