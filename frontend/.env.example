# Public client configuration only. Never add a service role or private keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Legacy public key alias remains supported during migration.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_WALLET_MODE=stellar

# Enable only after verifying publication and RLS in your Supabase project.
EXPO_PUBLIC_ENABLE_REALTIME=false

# Existing Stellar/passkey integration. Public settings, not signing secrets.
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_STELLAR_RELAYER_URL=
EXPO_PUBLIC_PASSKEY_RP_ID=
EXPO_PUBLIC_PASSKEY_ALLOWED_ORIGINS=
# Optional overrides: STELLAR_RPC_URL, STELLAR_HORIZON_URL,
# STELLAR_WALLET_WASM_HASH, STELLAR_ASSET_CONTRACT_ID,
# STELLAR_ASSET_CODE and STELLAR_ASSET_DECIMALS (all EXPO_PUBLIC_ prefixed).

# FastAPI host: use your PC LAN IP on a phone, or the deployed HTTPS URL.
EXPO_PUBLIC_PATOPAY_API_URL=http://127.0.0.1:8000
# UUID of the USDC asset registered in the backend (not its Stellar contract address).
EXPO_PUBLIC_PATOPAY_USDC_ASSET_ID=
