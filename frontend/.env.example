# Public client configuration only. Never add a service-role key or private key.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Blockchain is independent from product data in Supabase.
EXPO_PUBLIC_WALLET_MODE=mock
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Optional. Enable only after verifying Realtime publication and RLS.
EXPO_PUBLIC_ENABLE_REALTIME=false

# Required only when WALLET_MODE=stellar.
EXPO_PUBLIC_STELLAR_RELAYER_URL=
EXPO_PUBLIC_PASSKEY_RP_ID=
EXPO_PUBLIC_PASSKEY_ALLOWED_ORIGINS=

# Optional Stellar overrides (all EXPO_PUBLIC_ prefixed):
# STELLAR_RPC_URL, STELLAR_HORIZON_URL, STELLAR_FRIENDBOT_URL,
# STELLAR_EXPLORER_URL, STELLAR_WALLET_WASM_HASH,
# STELLAR_ASSET_CONTRACT_ID, STELLAR_ASSET_CODE, STELLAR_ASSET_DECIMALS.
